<schemalist gettext-domain="@GETTEXT_PACKAGE@">

  <enum id="@PACKAGE_ID@.AudioBackend">
    <value nick='none' value='0'/>
    @GSCHEMAXML_ALSA_BEGIN@<value nick='alsa' value='1'/>@GSCHEMAXML_ALSA_END@
    @GSCHEMAXML_OSS_BEGIN@<value nick='oss' value='2'/>@GSCHEMAXML_OSS_END@
    @GSCHEMAXML_PULSEAUDIO_BEGIN@<value nick='pulseaudio' value='3'/>@GSCHEMAXML_PULSEAUDIO_END@
  </enum>

  <enum id="@PACKAGE_ID@.PendulumAction">
    <value nick='center' value='0'/>
    <value nick='real' value='1'/>
    <value nick='edge' value='2'/>
  </enum>

  <enum id="@PACKAGE_ID@.PendulumPhaseMode">
    <value nick='left' value='0'/>
    <value nick='right' value='1'/>
  </enum>

  <!-- Deprecated -->
  <enum id="@PACKAGE_ID@.EnvelopeRampShape">
    <value nick='linear' value='1'/>
    <value nick='cubic' value='4'/>
    <value nick='cubic-flipped' value='5'/>
  </enum>

  <!-- Deprecated -->
  <enum id="@PACKAGE_ID@.EnvelopeHoldShape">
    <value nick='keep' value='0'/>
    <value nick='quartic' value='4'/>
  </enum>

  <!-- Deprecated -->
  <schema id="@PACKAGE_ID@.settings-list">
    <key name="entries" type="as">
      <default>[]</default>
    </key>
    <key name="selected-entry" type="s">
      <default>''</default>
    </key>
  </schema>

  <!-- Deprecated -->
  <schema id="@PACKAGE_ID@.preferences.sound.theme.parameters" >
    <key name="tone-pitch" type="d">
      <range min="40.0" max="10000.0"/>
      <default>500.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-timbre" type="d">
      <range min="0.0" max="3.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-detune" type="d">
      <range min="0.0" max="100.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-attack" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-attack-shape" enum="@PACKAGE_ID@.EnvelopeRampShape">
      <default>'linear'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="tone-hold" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-hold-shape" enum="@PACKAGE_ID@.EnvelopeHoldShape">
      <default>'keep'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="tone-decay" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="tone-decay-shape" enum="@PACKAGE_ID@.EnvelopeRampShape">
      <default>'linear'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="percussion-cutoff" type="d">
      <range min="40.0" max="10000.0"/>
      <default>5000.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="percussion-attack" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="percussion-attack-shape" enum="@PACKAGE_ID@.EnvelopeRampShape">
      <default>'linear'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="percussion-hold" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="percussion-hold-shape" enum="@PACKAGE_ID@.EnvelopeHoldShape">
      <default>'keep'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="percussion-decay" type="d">
      <range min="0.0" max="20.0"/>
      <default>5.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="percussion-decay-shape" enum="@PACKAGE_ID@.EnvelopeRampShape">
      <default>'linear'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="mix" type="d">
      <range min="-100.0" max="100.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="pan" type="d">
      <range min="-100.0" max="100.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
     </key>
    <key name="volume" type="d">
      <range min="0.0" max="125.0"/>
      <default>100.0</default>
      <summary></summary>
      <description></description>
     </key>
  </schema>

  <!-- Deprecated -->
  <schema id="@PACKAGE_ID@.preferences.sound.theme" >
    <key name="title" type="s">
      <default>'Untitled'</default>
      <description></description>
    </key>
    <child name="strong-params" schema="@PACKAGE_ID@.preferences.sound.theme.parameters"/>
    <child name="mid-params" schema="@PACKAGE_ID@.preferences.sound.theme.parameters"/>
    <child name="weak-params" schema="@PACKAGE_ID@.preferences.sound.theme.parameters"/>
  </schema>

  <!-- Deprecated -->
  <schema id="@PACKAGE_ID@.preferences.sound.theme-list"
	  extends="@PACKAGE_ID@.settings-list"
	  path="@PACKAGE_ID_PATH@/preferences/sound/themes/">
  </schema>

  <schema id="@PACKAGE_ID@.preferences.sound"
	  path="@PACKAGE_ID_PATH@/preferences/sound/">
    <key name="sound-theme-select" type="s">
      <default>'preset-01'</default>
      <summary>Selected sound theme</summary>
      <description></description>
    </key>
    <key name="volume" type="d">
      <range min="0.0" max="100.0"/>
      <default>75.0</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="auto-adjust-volume" type="b">
      <default>true</default>
      <summary>Whether the volume should be dropped when tapping</summary>
      <description></description>
    </key>
    <child name="themes" schema="@PACKAGE_ID@.preferences.sound.theme-list"/>
  </schema>

  <schema id="@PACKAGE_ID@.preferences.shortcuts"
	  path="@PACKAGE_ID_PATH@/preferences/shortcuts/">
    <key name="quit" type="s">
      <!-- Default shortcut to quit the application -->
      <!--
	  Translators: Please keep the regular single quotes around the shortcut strings as-is.
	   If you need to change a default shortcut, please keep in mind, that they have to be
	   valid accelerator strings parsable by the gtk_accelerator_parse function.
      -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;q'</default>
      <summary>Keyboard shortcut to quit the application</summary>
    </key>
    <key name="show-primary-menu" type="s">
      <!-- Default shortcut to show the primary menu -->
      <default l10n="messages" context="Default shortcut">'F10'</default>
      <summary>Keyboard shortcut to show the primary menu</summary>
    </key>
    <key name="show-profiles" type="s">
      <!-- Default shortcut to show the profiles menu -->
      <default l10n="messages" context="Default shortcut">'F9'</default>
      <summary>Keyboard shortcut to show the profiles menu</summary>
    </key>
    <key name="show-preferences" type="s">
      <!-- Default shortcut to show the preferences dialog -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;comma'</default>
      <summary>Keyboard shortcut to show the preferences dialog</summary>
    </key>
    <key name="show-shortcuts" type="s">
      <!-- Default shortcut to show the help for keyboard shortcuts -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;question'</default>
      <summary>Keyboard shortcut to show the help for keyboard shortcuts</summary>
    </key>
    <key name="show-help" type="s">
      <!-- Default shortcut to show the help -->
      <default l10n="messages" context="Default shortcut">'F1'</default>
      <summary>Keyboard shortcut to show the help</summary>
    </key>
    <key name="show-about" type="s">
      <default>'disabled'</default>
      <summary>Keyboard shortcut to show the about dialog</summary>
    </key>
    <key name="show-pendulum" type="s">
      <!-- Default shortcut to toggle the pendulum display -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;p'</default>
      <summary>Keyboard shortcut to toggle pendulum display</summary>
    </key>
    <key name="full-screen" type="s">
      <!-- Default shortcut to toogle full screen mode -->
      <default l10n="messages" context="Default shortcut">'F11'</default>
      <summary>Keyboard shortcut to toggle full screen mode</summary>
    </key>
    <key name="start" type="s">
      <default>'space'</default>
      <summary>Keyboard shortcut to start or stop the metronome</summary>
    </key>
    <key name="volume-increase-1" type="s">
      <default>'disabled'</default>
      <summary>Keyboard shortcut to increase the volume by 1 percent</summary>
    </key>
    <key name="volume-decrease-1" type="s">
      <default>'disabled'</default>
      <summary>Keyboard shortcut to decrease the volume by 1 percent</summary>
    </key>
    <key name="volume-increase-10" type="s">
      <default>'&lt;Alt&gt;Up'</default>
      <summary>Keyboard shortcut to increase the volume by 10 percent</summary>
    </key>
    <key name="volume-decrease-10" type="s">
      <default>'&lt;Alt&gt;Down'</default>
      <summary>Keyboard shortcut to decrease the volume by 10 percent</summary>
    </key>
    <key name="volume-mute" type="s">
      <!-- Default shortcut to mute the volume -->
      <default l10n="messages" context="Default shortcut">'m'</default>
      <summary>Keyboard shortcut to mute the volume</summary>
    </key>
    <key name="tempo-increase-1" type="s">
      <!-- Default shortcut to increase the tempo by 1 bpm -->
      <default l10n="messages" context="Default shortcut">'x'</default>
      <summary>Keyboard shortcut to increase the tempo by 1 bpm</summary>
    </key>
    <key name="tempo-decrease-1" type="s">
      <!-- Default shortcut to decrease the tempo by 1 bpm -->
      <default l10n="messages" context="Default shortcut">'z'</default>
      <summary>Keyboard shortcut to decrease the tempo by 1 bpm</summary>
    </key>
    <key name="tempo-increase-10" type="s">
      <!-- Default shortcut to increase the thempo by 10 bpm -->
      <default l10n="messages" context="Default shortcut">'&lt;Shift&gt;x'</default>
      <summary>Keyboard shortcut to increase the tempo by 10 bpm</summary>
    </key>
    <key name="tempo-decrease-10" type="s">
      <!-- Default shortcut to decrease the tempo by 10 bpm -->
      <default l10n="messages" context="Default shortcut">'&lt;Shift&gt;z'</default>
      <summary>Keyboard shortcut to decrease the tempo by 10 bpm</summary>
    </key>
    <key name="tempo-double" type="s">
      <default>'disabled'</default>
      <summary>Keyboard shortcut to double the tempo</summary>
    </key>
    <key name="tempo-half" type="s">
      <default>'disabled'</default>
      <summary>Keyboard shortcut to half the tempo</summary>
    </key>
    <key name="tempo-quick-set" type="s">
      <!-- Default shortcut to enter tempo quick set mode -->
      <default l10n="messages" context="Default shortcut">'q'</default>
      <summary>Keyboard shortcut to enter tempo quick set mode</summary>
    </key>
    <key name="tempo-tap" type="s">
      <!-- Default shortcut to tap the tempo -->
      <default l10n="messages" context="Default shortcut">'t'</default>
      <summary>Keyboard shortcut to tap the tempo</summary>
    </key>
    <key name="meter-enabled" type="s">
      <!-- Default shortcut to toggle accentuation -->
      <default l10n="messages" context="Default shortcut">'a'</default>
      <summary>Keyboard shortcut to toggle metric accentuation</summary>
    </key>
    <key name="meter-select-simple-2" type="s">
      <!-- Default shortcut to select the simple duple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;2'</default>
      <summary>Keyboard shortcut to select the simple duple meter</summary>
    </key>
    <key name="meter-select-simple-3" type="s">
      <!-- Default shortcut to select the simple triple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;3'</default>
      <summary>Keyboard shortcut to select the simple triple meter</summary>
    </key>
    <key name="meter-select-simple-4" type="s">
      <!-- Default shortcut to select the simple quadruple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;4'</default>
      <summary>Keyboard shortcut to select the simple quadruple meter</summary>
    </key>
    <key name="meter-select-compound-2" type="s">
      <!-- Default shortcut to select the compound duple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;6'</default>
      <summary>Keyboard shortcut to select the compound duple meter</summary>
    </key>
    <key name="meter-select-compound-3" type="s">
      <!-- Default shortcut to select the compound triple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;7'</default>
      <summary>Keyboard shortcut to select the compound triple meter</summary>
    </key>
    <key name="meter-select-compound-4" type="s">
      <!-- Default shortcut to select the compound quadruple meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;8'</default>
      <summary>Keyboard shortcut to select the compound quadruple meter</summary>
    </key>
    <key name="meter-select-custom" type="s">
      <!-- Default shortcut to select the custom meter -->
      <default l10n="messages" context="Default shortcut">'&lt;Primary&gt;0'</default>
      <summary>Keyboard shortcut to select the custom meter</summary>
    </key>
    <key name="trainer-enabled" type="s">
      <!-- Default shortcut to toggle the tempo trainer -->
      <default l10n="messages" context="Default shortcut">'s'</default>
      <summary>Keyboard shortcut to toggle tempo trainer</summary>
    </key>
    <key name="pendulum-toggle-phase" type="s">
      <!-- Default shortcut to toggle the pendulum phase -->
      <default l10n="messages" context="Default shortcut">'p'</default>
      <summary>Keyboard shortcut to toggle the pendulum phase</summary>
    </key>
  </schema>

  <schema id="@PACKAGE_ID@.preferences"
	  path="@PACKAGE_ID_PATH@/preferences/">
    <key name="restore-profile" type="b">
      <default>true</default>
      <summary>Whether to load the last profile used on startup</summary>
      <description></description>
    </key>
    <key name="link-sound-theme" type="b">
      <default>false</default>
      <summary>Wheter to link profiles and sound themes</summary>
      <description>
	If true, switching profiles also restores the previous sound theme. If the
	desired sound theme does not exist anymore, the default will be loaded instead.
      </description>
    </key>
    <key name="round-tapped-tempo" type="b">
      <default>true</default>
      <summary>Wheter to round the tapped tempo to a whole number</summary>
      <description></description>
    </key>
    <key name="input-device-latency" type="d">
      <range min="0.0" max="10000.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="pendulum-action" enum="@PACKAGE_ID@.PendulumAction">
      <default>'real'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="pendulum-phase-mode" enum="@PACKAGE_ID@.PendulumPhaseMode">
      <default>'left'</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="meter-animation" type="b">
      <default>true</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="animation-sync" type="d">
      <range min="-999.0" max="9999.0"/>
      <default>0.0</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="audio-backend" enum="@PACKAGE_ID@.AudioBackend">
      <default>@GSCHEMAXML_DEFAULT_AUDIO_BACKEND@</default>
      <summary>Which audio backend to use</summary>
      <description></description>
    </key>
    @GSCHEMAXML_ALSA_BEGIN@
    <key name="audio-device-alsa" type="s">
      <default>'default'</default>
      <summary>Audio device for the ALSA backend</summary>
      <description>
	ALSA compliant string representation for names of pcm devices
      </description>
    </key>
    @GSCHEMAXML_ALSA_END@
    @GSCHEMAXML_OSS_BEGIN@
    <key name="audio-device-oss" type="s">
      <default>'/dev/dsp'</default>
      <summary>Audio device for the OSS backend</summary>
      <description></description>
    </key>
    @GSCHEMAXML_OSS_END@
    @GSCHEMAXML_PULSEAUDIO_BEGIN@
    <key name="audio-device-pulseaudio" type="s">
      <default>''</default>
      <summary>Name of a sink for the pulseaudio backend</summary>
      <description></description>
    </key>
    @GSCHEMAXML_PULSEAUDIO_END@
    <child name="sound" schema="@PACKAGE_ID@.preferences.sound"/>
    <child name="shortcuts" schema="@PACKAGE_ID@.preferences.shortcuts"/>
  </schema>

  <schema id="@PACKAGE_ID@.state"
	  path="@PACKAGE_ID_PATH@/state/">
    <key name="first-launch" type="b">
      <default>true</default>
      <summary></summary>
      <description></description>
    </key>
    <key name="profile-select" type="s">
      <default>''</default>
      <summary>Selected profile</summary>
      <description></description>
    </key>
    <key name="show-pendulum" type="b">
      <default>true</default>
      <summary>Whether to show the animated pendulum</summary>
      <description></description>
    </key>
  </schema>

  <schema id="@PACKAGE_ID@" path="@PACKAGE_ID_PATH@/">
    <child name="preferences" schema="@PACKAGE_ID@.preferences"/>
    <child name="state" schema="@PACKAGE_ID@.state"/>
  </schema>

</schemalist>
